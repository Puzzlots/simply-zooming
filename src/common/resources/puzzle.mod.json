{
  "formatVersion": 3,
  "display-name": "${p_name}",
  "id": "${p_id}",
  "version": "${p_version}",
  "description": "${p_desc}",
  "authors": [
    ${p_authors}
  ],
  "can-load-on": {
    "client": true,
    "server": false
  },

  "meta": {
    "icon": "${p_id}:icons/icon.png"
  },

  "entrypoints": {
  },

  "mixins": [
    {
      "config": "${p_id}.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "cosmic-reach": ">=0.5.26-alpha",
    "puzzle-loader-cosmic": ">=1.7.3-alpha",
    "puzzle-loader-core": ">=1.4.1-alpha"
  },

  "access-writers": [
    "${p_id}.manipulator"
  ]
}